# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# Misc
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment — never commit real values.
# .env.example is committed and documents every variable.
.env
.env*.local
.env.development
.env.production

# Secrets and keys. Nothing of this shape belongs in the repository.
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json

# Vercel / deployment
.vercel

# TypeScript
*.tsbuildinfo

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code settings (may contain machine-specific paths)
.claude/settings.local.json
