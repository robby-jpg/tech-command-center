##############################################################################
# Tech Command Center — environment variables
#
# Copy to `.env.local` and fill in. Never commit a file containing real values.
#
# Nothing in this file is required to run V1. The application ships with a
# complete mock dataset and starts with no configuration at all.
##############################################################################

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Which provider the data layer resolves. See src/lib/data/index.ts.
#   mock      in-memory fixtures (default, and all V1 supports)
#   postgres  planned — see prisma/schema.prisma
DATA_SOURCE=mock

# Sevalla-hosted PostgreSQL, once the postgres provider exists.
# DATABASE_URL="postgresql://user:password@host:5432/tech_command_center?sslmode=require"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="https://tech.kindhomesolutions.com"

# ---------------------------------------------------------------------------
# Future integrations
#
# None of these are read by V1. They are listed so that the Integrations screen
# can report configured/not-configured, and so that the variable names are
# settled before anyone wires an adapter up.
#
# A System record references the NAME of the variable holding its credentials
# (`credentialEnvKey`). It never stores the value. Secrets stay on the server
# and are never sent to the browser — do not prefix any of these NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Salesforce — connected app, OAuth 2.0 client credentials flow
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# Microsoft Fabric / Power BI — Entra ID app registration
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
# POWER_BI_CLIENT_SECRET=
# POWER_BI_WORKSPACE_ID=

# Zapier — for reading zap status and failure counts
# ZAPIER_API_KEY=

# Slack — ticket intake and notifications
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_TECH_CHANNEL_ID=

# Google Workspace — identity and directory
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT=
# GOOGLE_WORKSPACE_ADMIN_SUBJECT=

# Other systems in the estate
# HUBSPOT_PRIVATE_APP_TOKEN=
# PANDADOC_API_KEY=
# AIRCALL_API_TOKEN=
# APPTOTO_API_KEY=
# COMPANYCAM_API_TOKEN=
# SALESRABBIT_API_KEY=
# JOTFORM_API_KEY=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# BART_API_TOKEN=
# ESTIMATOR_PORTAL_DATABASE_URL=

# ClickUp — one-time historical import only
# CLICKUP_API_TOKEN=
# CLICKUP_TEAM_ID=

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
#
# Google sign-in, restricted to one company domain. The application will not
# render anything without a session: proxy.ts redirects anonymous requests and
# getWorkspaceSnapshot() refuses to assemble the working set.
#
# AUTH_SECRET signs the session cookie. Generate one with:
#     npx auth secret
# A different value per environment is fine; changing it signs everyone out.
#
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET come from a Google Cloud OAuth 2.0
# Client ID of type "Web application". Its Authorised redirect URIs must list
# every origin the app runs on, each with the /api/auth/callback/google path:
#     http://localhost:3000/api/auth/callback/google
#     https://<your-host>/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# REQUIRED IN PRODUCTION. Auth.js will not trust the incoming Host header
# unless one of AUTH_URL / AUTH_TRUST_HOST / VERCEL / CF_PAGES is set *or*
# NODE_ENV is not "production" (see @auth/core/lib/utils/env.ts). Local
# development therefore works with neither set, and the deployed app fails
# every sign-in with UntrustedHost. Setting the full URL is preferable to
# AUTH_TRUST_HOST=true because it also pins the OAuth callback origin, so a
# custom domain later is a one-variable change.
#     AUTH_URL=https://tech-command-center-ib78o.sevalla.app

# The only email domain allowed to sign in. Enforced server-side against
# Google's `hd` (hosted domain) claim, which only Workspace accounts in that
# domain receive — not by string-matching the address alone.
# Defaults to kindhomesolutions.com when unset.
# AUTH_ALLOWED_DOMAIN=kindhomesolutions.com

# Anthropic — reads meeting transcripts in Brainstorming → Discovery Sessions.
# Without it the "Analyze with Claude" button reports missing credentials; everything
# else in the application works unchanged.
ANTHROPIC_API_KEY=
