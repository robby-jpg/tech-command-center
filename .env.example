##############################################################################
# Tech Command Center — environment variables
#
# Copy to `.env.local` and fill in. Never commit a file containing real values.
#
# Nothing in this file is required to run V1. The application ships with a
# complete mock dataset and starts with no configuration at all.
##############################################################################

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Which provider the data layer resolves. See src/lib/data/index.ts.
#   mock      in-memory fixtures (default, and all V1 supports)
#   postgres  planned — see prisma/schema.prisma
DATA_SOURCE=mock

# Sevalla-hosted PostgreSQL, once the postgres provider exists.
# DATABASE_URL="postgresql://user:password@host:5432/tech_command_center?sslmode=require"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="https://tech.kindhomesolutions.com"

# ---------------------------------------------------------------------------
# Future integrations
#
# None of these are read by V1. They are listed so that the Integrations screen
# can report configured/not-configured, and so that the variable names are
# settled before anyone wires an adapter up.
#
# A System record references the NAME of the variable holding its credentials
# (`credentialEnvKey`). It never stores the value. Secrets stay on the server
# and are never sent to the browser — do not prefix any of these NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Salesforce — connected app, OAuth 2.0 client credentials flow
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# Microsoft Fabric / Power BI — Entra ID app registration
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
# POWER_BI_CLIENT_SECRET=
# POWER_BI_WORKSPACE_ID=

# Zapier — for reading zap status and failure counts
# ZAPIER_API_KEY=

# Slack — ticket intake and notifications
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_TECH_CHANNEL_ID=

# Google Workspace — identity and directory
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT=
# GOOGLE_WORKSPACE_ADMIN_SUBJECT=

# Other systems in the estate
# HUBSPOT_PRIVATE_APP_TOKEN=
# PANDADOC_API_KEY=
# AIRCALL_API_TOKEN=
# APPTOTO_API_KEY=
# COMPANYCAM_API_TOKEN=
# SALESRABBIT_API_KEY=
# JOTFORM_API_KEY=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# BART_API_TOKEN=
# ESTIMATOR_PORTAL_DATABASE_URL=

# ClickUp — one-time historical import only
# CLICKUP_API_TOKEN=
# CLICKUP_TEAM_ID=

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
#
# Google sign-in restricted to one company domain, using the same variable
# contract as the other Kind Home tools (the Estimator Portal and the SDR
# Portal). Same names, same meanings, so the Sevalla screens match.
#
# The application will not render anything without a session: proxy.ts
# redirects anonymous requests and getWorkspaceSnapshot() refuses to assemble
# the working set. GET /healthz reports {"mode":"GOOGLE","gated":true} once
# this is configured.
#
# One Google OAuth client can carry several Authorised redirect URIs, so this
# app can reuse the existing Kind Home client — add its callback URI to that
# client rather than creating a new one.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED IN PRODUCTION. The registered redirect URI, stated rather than
# inferred — guessing it from request headers means trusting a value the caller
# can forge. It is also what makes Auth.js trust the incoming Host: without it
# trustHost is false whenever NODE_ENV is "production", so sign-in works on
# localhost and fails on Sevalla with UntrustedHost.
#
# Must match the Google console entry character for character. A mismatch shows
# as redirect_uri_mismatch, which is the single most common thing to get wrong.
#     local  http://localhost:3000/auth/callback/google
#     live   https://tech-command-center-ib78o.sevalla.app/auth/callback/google
OAUTH_CALLBACK_URL=

# Signs the session cookie. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out. Per-environment values are fine.
AUTH_SECRET=

# The only email domain allowed in. Unlike the Estimator Portal, blank does not
# mean "any" — it falls back to kindhomesolutions.com, because an accidentally
# blank value on this application would publish the department.
# ALLOWED_EMAIL_DOMAIN=kindhomesolutions.com

# Anthropic — reads meeting transcripts in Brainstorming → Discovery Sessions.
# Without it the "Analyze with Claude" button reports missing credentials; everything
# else in the application works unchanged.
ANTHROPIC_API_KEY=
